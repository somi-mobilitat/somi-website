{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility":   ["error", { "minScore": 0.75 }],
        "categories:best-practices":  ["error", { "minScore": 0.75 }],
        "categories:seo":             ["error", { "minScore": 0.90 }]
      }
    }
  }
}
